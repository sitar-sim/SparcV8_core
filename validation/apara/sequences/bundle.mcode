// The instructions of a bundle run in parallel: every one reads the
// registers as they were before the bundle.

swap:
    ||
        + $r1 ($i64) $r2 0      // $r1 = old $r2
        + $r2 ($i64) $r1 0      // $r2 = old $r1
        + $r3 ($i64) $r0 1
        + $r4 ($i64) $r3 1      // old $r3 (0) + 1
    ;
    || $halt ;
