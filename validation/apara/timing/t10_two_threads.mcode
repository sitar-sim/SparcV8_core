// Timing: two threads. FETCH sends thread 0's line (bundles at 0x0,
// 0x1, 0x2, 0x4) in cycles 0-3, then picks thread 1 and fetches its
// $halt at 0x8 in cycle 4. That halt leaves WRITEBACK in cycle 9:
// 10 cycles. (Thread 0's bundles after its own $halt are skipped.)
//
//@ cycles: 10
//@ threads: 0x0 0x8
//@ expect: 0 pc 0x1
//@ expect: 1 pc 0x9
    || $halt ;
    || $null ;
    || $null $null ;
    || $null $null $null $null ;
    || $halt ;
