// Control where this model deviates from the APARA reference model
// (Ref docs/apara, deviations): $return pops the return-address stack
// (so calls nest), an unsigned test compares unsigned values, and a
// $cmov increment is a signed 2-bit value.

    ||
        ? ($u64) $r1 > $goto big         // 2^63 > 0 as an unsigned value
    ;
    || $halt ;                           // not reached
big:
    ||
        + $r2 ($i64) $r0 1
    ;
    ||
        $cmov ($i64) $r2 != --1 $r3 $r4  // $r4 != 0: $r3 = 1, $r4 = 3 - 1
    ;
    ||
        $call outer
    ;
    ||
        + $r5 ($i64) $r0 1               // back from outer
    ;
    || $halt ;
outer:
    ||
        $call inner
    ;
    ||
        + $r6 ($i64) $r0 1               // back from inner
    ;
    ||
        $return
    ;
inner:
    ||
        + $r7 ($i64) $r0 1
        $return
    ;
