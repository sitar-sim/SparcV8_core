// Exceptions stop a thread (this model's addition; the reference model
// reports them and continues). The faulting bundle changes nothing: the
// thread halts at its PC with ERROR = 0x01000000 | (code << 3*slot):
// codes 1 integer divide by zero, 2 float divide by zero, 3 float NaN,
// 5 negative square root, 6 unaligned address, 7 illegal instruction or
// bundle. A return-address stack error sets ERROR bit 26 instead.

    ||                                   // 0x0: divide (lane 1) by zero
        / $r3 ($i64) $r1 $r0
    ;
    ||                                   // 0x8: an 8-byte load (lane 4) at 4
        $ld ($i64) $r2 [$r0 + 4]
    ;
    ||                                   // 0x10: return with nothing to return to
        $return
    ;
    ||                                   // 0x18: 1.0 / 0.0
        / $r3 ($f32) $r1 $r0
    ;
