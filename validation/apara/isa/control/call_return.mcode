// $call label and $call $rs2 (the target is the call's own address plus
// $rs2), each with a $return: the return-address stack holds the address
// of the bundle after the call. One level deep here (nested calls:
// Ref deviations/dev_control).

    || $call add_one ;                          // 0x0: returns to 0x8
    || + $r3 ($i64) $r0 24 ;                    // 0x8
    || $call $r3 ;                              // 0x10: to 0x10 + 24 = 0x28
    || + $r4 ($i64) $r1 $r0 ;                   // 0x18: after the second call
    || $halt ;                                  // 0x19
add_one:
    || + $r1 ($i64) $r1 1  $return ;            // 0x20 (a control bundle: 8 slots)
    || + $r1 ($i64) $r1 10  $return ;           // 0x28
