// Integer *: signed types sign-extend, unsigned types use whole registers;
// the product is the low 64 bits.

||
    *  $r10 ($i64) $r1 $r1      // 100 * 100 = 10000
    *  $r11 ($i16) $r1 $r2      // 100 * -7 = -700
    *  $r12 ($u16) $r2 $r2      // 0xfff9 * 0xfff9 (unsigned, whole registers)
    *  $r13 ($i64) $r3 $r3      // 2^36 * 2^36 = 2^72: the low 64 bits are 0
    *  $r14 ($i32) $r4 $r4      // -1 * -1 = 1
    *  $r15 ($u32) $r4 $r4      // 0xffffffff * 0xffffffff
    *  $r16 ($i64) $r5 -3       // 7 * -3 = -21
    *  $r17 ($i8)  $r2 $r5      // 0xf9 is -7 as i8: -49
;
|| $halt ;
