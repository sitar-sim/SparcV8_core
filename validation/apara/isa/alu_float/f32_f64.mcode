// Float + - * / on f32 and f64 (IEEE single and double). A float result
// has the source's type, in the register's low bits.

||
    +  $r10 ($f32) $r1 $r2      // 1.5 + 2.25 = 3.75
    -  $r11 ($f32) $r1 $r2      // -0.75
    *  $r12 ($f32) $r2 $r3      // 2.25 * -0.5 = -1.125
    +  $r14 ($f64) $r4 $r5      // 1.5 + 0.1 = 1.6
    *  $r15 ($f64) $r5 $r5      // 0.1 * 0.1
;
|| /  $r13 ($f32) $r1 $r3 ;     // 1.5 / -0.5 = -3.0
|| /  $r16 ($f64) $r4 $r5 ;     // 1.5 / 0.1 = 15.0 (rounded)
|| $halt ;
