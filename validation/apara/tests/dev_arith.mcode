// Arithmetic where this model deviates from the APARA reference model
// (Ref docs/apara, deviations): reductions start from their operation's
// identity, unsigned reduction elements are zero-extended, a float $dot
// accumulates, float casts and $fsqrt are implemented, a cast from a
// 64-bit source is truncated, a 4-byte load at offset 4 reads the low
// half, and a negative load increment is a 64-bit subtraction.
//
//@ deviation: reductions, float dot/cast/sqrt, 64-bit cast source, 4-byte load half, negative increment
//@ data: 0: 0x0123456789abcdef
//@ data: 2: 0x2222222222222222
//@ reg: 0 $r1 0x0102030405060708
//@ reg: 0 $r2 0xffffffffffffff0f
//@ reg: 0 $r3 0xff01000000000000
//@ reg: 0 $r4 0x3fc0000040100000
//@ reg: 0 $r5 0x3c004000be003800
//@ reg: 0 $r6 0x3800380038003800
//@ reg: 0 $r7 0x40000000
//@ reg: 0 $r8 0xffffff38
//@ reg: 0 $r9 0xc348b333
//@ reg: 0 $r10 0x501502f9
//@ reg: 0 $r11 0x4004000000000000
//@ reg: 0 $r12 0x12345678abcdef80
//@ reg: 0 $r13 0x40100000
//@ reg: 0 $r14 0x4002000000000000
//@ reg: 0 $r29 16
//@ expect: 0 reg $r16 0x9d80
//@ expect: 0 reg $r17 0xf
//@ expect: 0 reg $r18 0xfffffffffffffff7
//@ expect: 0 reg $r19 0x100
//@ expect: 0 reg $r20 0x40580000
//@ expect: 0 reg $r7  0x40400000
//@ expect: 0 reg $r21 0xc3480000
//@ expect: 0 reg $r22 0xffffff38
//@ expect: 0 reg $r23 0x7f
//@ expect: 0 reg $r24 0x40200000
//@ expect: 0 reg $r25 0xef80
//@ expect: 0 reg $r26 0x3fc00000
//@ expect: 0 reg $r27 0x3ff8000000000000
//@ expect: 0 reg $r28 0x89abcdef
//@ expect: 0 reg $r30 0x2222222222222222
//@ expect: 0 reg $r29 0x8

reduce:
    ||
        $vreduce *  $r16 ($vi8)  $r1     // 8! (the reference starts from 0)
        $vreduce &  $r17 ($vi8)  $r2     // (-1 & ... & 0x0f)
        $vreduce ~^ $r18 ($vi8)  $r1
        $vreduce +  $r19 ($vu8)  $r3     // 255 + 1
        $vreduce *  $r20 ($vf32) $r4     // 1.5 * 2.25
        $dot $accumulate $r7 ($vf16) $r5 $r6   // 2.0 + 1.0
    ;
casts:
    ||
        $cast ($f32) $r21 ($i32) $r8     // -200 -> -200.0
        $cast ($i32) $r22 ($f32) $r9     // -200.7 -> -200, toward zero
        $cast ($i8)  $r23 ($f32) $r10    // 1e10 saturates to 127
        $cast ($f32) $r24 ($f64) $r11    // 2.5
        $cast ($i16) $r25 ($i64) $r12    // truncated to 16 bits
    ;
sqrt32:
    ||
        $fsqrt $r26 ($f32) $r13          // 1.5
    ;
sqrt64:
    ||
        $fsqrt $r27 ($f64) $r14
    ;
memory:
    ||
        $ld ($u32) $r28 [$r0 + 4]        // the low half of dword 0
        $ld ($i64) $r30 [$r0 + $r29 --1] // dword 2, then $r29 = 16 - 8
    ;
    || $halt ;
