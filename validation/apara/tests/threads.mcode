// Four threads share IMEM and DMEM and run one bundle each in turn
// (round robin). Threads 0-2 start at 0x0, thread 3 at 0x8. Each has its
// own registers: $r1 = 8 * thread, $r2 = 0x100 + thread.
//
//@ threads: 0x0 0x0 0x0 0x8
//@ reg: 0 $r1 0x0
//@ reg: 0 $r2 0x100
//@ reg: 1 $r1 0x8
//@ reg: 1 $r2 0x101
//@ reg: 2 $r1 0x10
//@ reg: 2 $r2 0x102
//@ reg: 3 $r1 0x18
//@ reg: 3 $r2 0x103
//@ expect: 0 mem 0x0 0x100
//@ expect: 0 mem 0x1 0x101
//@ expect: 0 mem 0x2 0x102
//@ expect: 0 mem 0x3 0x0
//@ expect: 0 mem 0x4 0x102
//@ expect: 0 reg $r3 0x200
//@ expect: 1 reg $r3 0x202
//@ expect: 2 reg $r3 0x204
//@ expect: 3 reg $r3 0x206
//@ expect: 0 pc 0xa
//@ expect: 1 pc 0xa
//@ expect: 2 pc 0xa
//@ expect: 3 pc 0xa

store:                                   // 0x0
    ||
        $st ($i64) [$r1 + 0]  $r2        // each thread its own dword
        $st ($i64) [$r0 + 32] $r2        // all to dword 4: thread 2 is last
    ;
double:                                  // 0x8
    ||
        + $r3 ($i64) $r2 $r2
    ;
    ||                                   // 0x9
        $halt
    ;
