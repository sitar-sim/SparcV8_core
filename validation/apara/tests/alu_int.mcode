// Scalar integer ALU: signed operations sign-extend their operands from
// the type's width, unsigned ones use the whole 64-bit registers; every
// result is 64 bits. Immediates are 10-bit signed values.
//
//@ expect: 0 reg $r5 0x67
//@ expect: 0 reg $r6 0xffffffffffffff9f
//@ expect: 0 reg $r7 0xfffffffffffffd44
//@ expect: 0 reg $r8 0x1fff2
//@ expect: 0 reg $r9 0xfffffffffffffff0
//@ expect: 0 reg $r10 0x69
//@ expect: 0 reg $r11 0x30
//@ expect: 0 reg $r12 0xfffffffffffffffc
//@ expect: 0 reg $r13 0xfffffffffffffff2
//@ expect: 0 reg $r14 0xfff
//@ expect: 0 reg $r15 0xf0
//@ expect: 0 reg $r16 0xf3
//@ expect: 0 reg $r17 0xf
//@ expect: 0 reg $r18 0xffffffffffffff0c
//@ expect: 0 reg $r19 0xffffffffffffff0f
//@ expect: 0 reg $r20 0xffffffffffffffff
//@ expect: 0 pc 0x19

init:
    ||
        $set $r1 0 100          // 100
        $set $r2 0 _hfff9       // 0xfff9, -7 as an $i16
        $set $r3 0 _hf0         // 0xf0, -16 as an $i8
        $set $r4 0 3
    ;
arith:
    ||
        +  $r5  ($i64) $r1 $r4  // 103
        -  $r6  ($i64) $r4 $r1  // -97
        *  $r7  ($i16) $r1 $r2  // 100 * -7 = -700
        +  $r8  ($u16) $r2 $r2  // unsigned: 0xfff9 + 0xfff9, not wrapped to 16 bits
        +  $r9  ($i8)  $r3 $r0  // -16
        -  $r10 ($i64) $r1 -5   // 105
        << $r11 ($i64) $r4 4    // 48
        >> $r12 ($i16) $r2 1    // arithmetic: -7 >> 1 = -4
    ;
logic:
    ||
        /  $r13 ($i16) $r1 $r2  // 100 / -7 = -14, toward zero
        >> $r14 ($u64) $r2 4    // logical: 0xfff
        &  $r15 ($i64) $r2 $r3  // 0xf0
        |  $r16 ($i64) $r3 $r4  // 0xf3
        ^  $r17 ($i64) $r3 255  // 0x0f
        ~| $r18 ($i64) $r3 $r4  // ~0xf3
        ~& $r19 ($i64) $r3 $r3  // ~0xf0
        ~^ $r20 ($i64) $r3 $r3  // ~0
    ;
done:
    || $halt ;
