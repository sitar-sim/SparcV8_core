// Scalar float arithmetic, f8 to f64: 1.5 and 2.25 combined with + - * /.
// Results are in the type's format, in the low bits.
//
//@ reg: 0 $r1 0x3fc00000
//@ reg: 0 $r2 0x40100000
//@ reg: 0 $r3 0x3ff8000000000000
//@ reg: 0 $r4 0x4002000000000000
//@ reg: 0 $r5 0x3e00
//@ reg: 0 $r6 0x4080
//@ reg: 0 $r7 0x3c
//@ reg: 0 $r8 0x41
//@ expect: 0 reg $r9 0x40700000
//@ expect: 0 reg $r10 0xbf400000
//@ expect: 0 reg $r11 0x40580000
//@ expect: 0 reg $r12 0x3f2aaaab
//@ expect: 0 reg $r13 0x400e000000000000
//@ expect: 0 reg $r14 0xbfe8000000000000
//@ expect: 0 reg $r15 0x400b000000000000
//@ expect: 0 reg $r16 0x3fe5555555555555
//@ expect: 0 reg $r17 0x4380
//@ expect: 0 reg $r18 0x42c0
//@ expect: 0 reg $r19 0x47

f32:
    ||
        + $r9  ($f32) $r1 $r2    // 3.75
        - $r10 ($f32) $r1 $r2    // -0.75
        * $r11 ($f32) $r1 $r2    // 3.375
        / $r12 ($f32) $r1 $r2    // 0.6666667
    ;
f64:
    ||
        + $r13 ($f64) $r3 $r4
        - $r14 ($f64) $r3 $r4
        * $r15 ($f64) $r3 $r4
        / $r16 ($f64) $r3 $r4
    ;
narrow:
    ||
        + $r17 ($f16) $r5 $r6    // 3.75
        * $r18 ($f16) $r5 $r6    // 3.375
        + $r19 ($f8)  $r7 $r8    // 3.75
        $null
    ;
done:
    || $halt ;
