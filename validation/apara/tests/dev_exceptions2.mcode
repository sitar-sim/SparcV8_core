// More exceptions (Ref dev_exceptions.mcode): a float NaN result, a
// thread started inside a bundle (no valid bundle: code 7 in slot 0),
// a return-address stack overflow, and a negative square root.
//
//@ deviation: exceptions
//@ threads: 0x0 0x3 0x10 0x18
//@ reg: 0 $r1 0x7f800000
//@ reg: 3 $r1 0xbf800000
//@ expect: 0 error 0x1000003
//@ expect: 1 error 0x1000007
//@ expect: 1 pc 0x3
//@ expect: 2 error 0x4000000
//@ expect: 2 pc 0x10
//@ expect: 3 error 0x1000028

    ||                                   // 0x0: infinity - infinity
        - $r3 ($f32) $r1 $r1
    ;
    ||                                   // 0x1
        $null
    ;
    ||                                   // 0x2: thread 1 starts at 0x3, inside this bundle
        $null $null
    ;
    ||                                   // 0x4
        $null $null $null $null
    ;
    ||                                   // 0x8
        $halt
    ;
recurse:
    ||                                   // 0x10: calls itself until the stack is full
        $call recurse
    ;
    ||                                   // 0x18: sqrt(-1.0), lane 1
        $fsqrt $r3 ($f32) $r1
    ;
