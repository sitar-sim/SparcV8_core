// $cmov (type) $rs1 <condition> [increment] $rd $rs2: if $rs2 satisfies
// the condition (compared with 0), $rd = $rs1. The register tested is
// the last one written; the increment is added to it.
//
//@ reg: 0 $r1 5
//@ reg: 0 $r3 7
//@ reg: 0 $r4 0xaa
//@ reg: 0 $r5 0xbb
//@ reg: 0 $r6 0xffffffffffffffff
//@ reg: 0 $r10 3
//@ expect: 0 reg $r4 0x5
//@ expect: 0 reg $r5 0xbb
//@ expect: 0 reg $r7 0x5
//@ expect: 0 reg $r9 0x5
//@ expect: 0 reg $r10 0x4

cmov:
    ||
        $cmov ($i64) $r1 ==     $r4 $r2   // $r2 == 0: $r4 = 5
        $cmov ($i64) $r1 ==     $r5 $r3   // $r3 != 0: $r5 unchanged
        $cmov ($i8)  $r1 <      $r7 $r6   // -1 < 0: $r7 = 5
        $cmov ($i64) $r1 != ++1 $r9 $r10  // 3 != 0: $r9 = 5, then $r10 = 4
    ;
    || $halt ;
