// Vector ALU ($v + - *, element by element, element 0 in the most
// significant bits), $dot and $vreduce.
//
//@ reg: 0 $r1 0x01020304050607f8
//@ reg: 0 $r2 0x1010101010101010
//@ reg: 0 $r7 0x5
//@ reg: 0 $r8 0x3c004000be003800
//@ reg: 0 $r9 0x3800380038003800
//@ reg: 0 $r11 0x0102030405060708
//@ reg: 0 $r12 0x01010101010101ff
//@ reg: 0 $r15 100
//@ reg: 0 $r20 0xfffefdfc04030201
//@ reg: 0 $r21 0x3fc0000040100000
//@ expect: 0 reg $r3 0x1112131415161708
//@ expect: 0 reg $r4 0xf0f2f2f4f4f6f7e8
//@ expect: 0 reg $r5 0x1020304050607080
//@ expect: 0 reg $r6 0x060708090a0b0cfd
//@ expect: 0 reg $r10 0x38003c00ba003400
//@ expect: 0 reg $r13 0x14
//@ expect: 0 reg $r14 0x814
//@ expect: 0 reg $r15 0x78
//@ expect: 0 reg $r16 0x171e04
//@ expect: 0 reg $r17 0x3f800000
//@ expect: 0 reg $r22 0x24
//@ expect: 0 reg $r23 0x1014
//@ expect: 0 reg $r24 0x0
//@ expect: 0 reg $r25 0x6080a0c
//@ expect: 0 reg $r26 0x40700000
//@ expect: 0 reg $r27 0xf
//@ expect: 0 reg $r28 0x8

valu:
    ||
        $v + $r3 ($vi8)  $r1 $r2             // per element, wrapping at 8 bits
        $v - $r4 ($vi16) $r1 $r2
        $v * $r5 ($vu8)  $r1 $r2
        $v + $r6 ($vi8)  $r1 $r7 $replicate  // $r7's low element added to every element
        $v * $r10 ($vf16) $r8 $r9            // (1, 2, -1.5, 0.5) * 0.5
    ;
dot:
    ||
        $dot $r13 ($vi8)  $r11 $r12          // 1+2+...+7 + 8*(-1) = 20
        $dot $r14 ($vu8)  $r11 $r12          // 28 + 8*255
        $dot $accumulate $r15 ($vi8) $r11 $r12  // 100 + 20
        $dot $r16 ($vi16) $r11 $r12
        $dot $r17 ($vf16) $r8 $r9            // f32 result: 0.5+1-0.75+0.25
    ;
reduce:
    ||
        $vreduce + $r22 ($vi8)  $r11         // 36
        $vreduce + $r23 ($vi16) $r11         // 0x0102+0x0304+0x0506+0x0708
        $vreduce + $r24 ($vi8)  $r20         // -1-2-3-4+4+3+2+1 = 0
        $vreduce + $r25 ($vi32) $r11
        $vreduce + $r26 ($vf32) $r21         // f32 result: 1.5 + 2.25
        $vreduce | $r27 ($vi8)  $r11         // 1|2|...|8
        $vreduce ^ $r28 ($vi8)  $r11         // 1^2^...^8
    ;
done:
    || $halt ;
