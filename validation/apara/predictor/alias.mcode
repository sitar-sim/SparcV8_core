// The branch predictor (Ref docs: the timing model's Branch prediction):
// a 256-entry BTB, direct mapped by the low 8 bits of the bundle's PC and
// tagged with the rest, shared by all threads. An entry predicts its
// target while its 2-bit counter is below 3 (0 strongly taken). Only
// mispredicts train it: a taken one creates an entry at 0 (or lowers the
// counter and sets the target), a not-taken one raises the counter (or
// creates an entry at 3). MISPREDICTS is checked on the timing model.
//
// Two loops whose closing branches are 256 words apart (0x8 and 0x108):
// the same BTB entry, different tags. Each loop's entry evicts the other's,
// so every instance of each loop mispredicts at entry and at exit: 3
// instances * 2 loops * 2 = 12, plus 2 for the outer loop: 14 (Ref
// no_alias: 10).

    || + $r1 ($i64) $r0 2 ;                 // the outer loop: 3 passes
outer:
    || + $r2 ($i64) $r0 2 ;                 // loop a: 3 passes
a:
    || + $r3 ($i64) $r3 1 ;
    || ? ($i64) $r2 > --1 $goto a ;         // at 0x8
    || + $r4 ($i64) $r0 2 ;                 // loop b: 3 passes
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
    || $null $null $null $null $null $null $null $null ;
b:
    || + $r5 ($i64) $r5 1 ;
    || ? ($i64) $r4 > --1 $goto b ;
    || ? ($i64) $r1 > --1 $goto outer ;
    || $halt ;
