// Writes i*i for i = 0..15 as dwords at $r1 (an address in DMEM's
// window). Its loop branch is at 0x8, back to 0x1.
start:
    || + $r2 ($i64) $r0 15 ;
loop:
    || * $r3 ($i64) $r2 $r2 ;
    || << $r4 ($i64) $r2 3 ;
    || ? ($i64) $r2 >= --1 $goto store ;
store:
    || + $r5 ($i64) $r1 $r4 ;
    || $st ($i64) [$r5 + 0] $r3 ;
    || ? ($i64) $r2 >= $goto loop ;
    || $halt ;
