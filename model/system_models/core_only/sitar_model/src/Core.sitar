
//================================================================
// module Core
// Author: Neha Karanjkar
//
// Wrapper module for the SPARC V8 core. Assembles SparcThread (the state
// machine, plus its 5 memory-interface procedures) with a single
// VirtualMainMemory instance.
//
// sparcThread and mainMemory run as two branches of one parallel block,
// so their handshake completes within a single phase. mainMemory owns
// its own request/response state. This module's only job is to wire
// each of sparcThread's 5 memory-interface procedures' downstream
// pointers at mainMemory's own fields. All 5 point at the one
// mainMemory, safe because SparcThread's FSM only ever has one memory
// access in flight at a time.
//================================================================

module Core

	include
	$
	#include "SparcCore.h"
	$

	//Sparc Thread (contains the state machine and memory interface procedures)
	procedure sparcThread : SparcThread

	//The memory this core's 5 memory-interface procedures all share.
	procedure mainMemory : VirtualMainMemory

	init
	$
	sparcThread.ifetchProcedure.downstreamRequest           = &mainMemory.request;
	sparcThread.ifetchProcedure.downstreamResponse          = &mainMemory.response;
	sparcThread.memReadProcedure.downstreamRequest          = &mainMemory.request;
	sparcThread.memReadProcedure.downstreamResponse         = &mainMemory.response;
	sparcThread.memWriteProcedure.downstreamRequest         = &mainMemory.request;
	sparcThread.memWriteProcedure.downstreamResponse        = &mainMemory.response;
	sparcThread.atomicLoadStoreProcedure.downstreamRequest  = &mainMemory.request;
	sparcThread.atomicLoadStoreProcedure.downstreamResponse = &mainMemory.response;
	sparcThread.flushProcedure.downstreamRequest            = &mainMemory.request;
	sparcThread.flushProcedure.downstreamResponse           = &mainMemory.response;

	//---------------------------------------------------------
	// Model latency parameter settings -- a single, consolidated place to
	// view/tune every latency knob in this configuration. Each knob is
	// also declared and defaulted (to 0) in its own owning procedure; the
	// value set here runs afterward (Sitar's child-then-parent init
	// order) and is the authoritative one for the simulation.
	//---------------------------------------------------------
	//Opcode-wise latency: compile-time, see OpcodeLatencies.h
	//(DEFAULT_PER_OPCODE_DELAY / OPCODE_LATENCY_OVERRIDES) -- not
	//settable here.
	//
	//Core-side interconnect latency (memory-interface delay: cycles
	//beyond 0-delay procedure-call semantics, per access type):
	sparcThread.ifetchProcedure.delay          = 0; //ifetch
	sparcThread.memReadProcedure.delay         = 0; //load
	sparcThread.memWriteProcedure.delay        = 0; //store
	sparcThread.atomicLoadStoreProcedure.delay = 0; //atomic load-store
	sparcThread.flushProcedure.delay           = 0; //flush
	//
	//Memory service latency:
	mainMemory.delay = 0; //cycles mainMemory itself takes to service a request
	//---------------------------------------------------------
	$


	behavior
		[
			// sparcThread's own procedure never returns -- it loops
			// forever across RESET/EXECUTE/ERROR, by design (see the
			// "Conventions" note in SparcThread.sitar) -- so this branch
			// never completes either. That's fine: nothing here waits
			// on it to.
			run sparcThread;
		||
			// mainMemory is persistent -- this branch runs for the whole
			// simulation, servicing requests until the monitor branch
			// below calls `stop simulation`.
			run mainMemory;
		||
			// Watches for the core halting and stops the whole
			// simulation once it does. Has to live out here, watching
			// sparcThread.HALT.VALUE from outside, rather than as
			// something sparcThread does itself when its own procedure
			// returns -- see above, it never does.
			wait until (sparcThread.HALT.VALUE);

			// HALT.VALUE just became true in phase 0 of this same cycle
			// (see SparcThread.sitar's ERROR branch); let phase 1 run
			// its course too before tearing the simulation down, rather
			// than stopping mid-cycle.
			wait until (this_phase==1);

			$
			log<<endl<<"Core halted.";
			log<<endl<<sparcThread.printInfo();
			$;
			stop simulation;

			// Example (commented out): selectively turn sparcThread's own
			// logging on/off at runtime, based on simulated time and/or
			// PC, instead of for the whole run -- e.g. to narrow a
			// --logging build's trace file down to just the part of
			// a long run you actually care about. Uncomment and adjust
			// the two conditions below to try it; verified working
			// (compiles, and correctly turns sparcThread.log on and off
			// as `current_time`/PC cross the given bounds) as of this
			// writing. See docs/source/logging.md ("Selective on/off at
			// runtime") for the full explanation, and Sitar's own
			// Logging documentation for turnON()/turnOFF()/isON() (the
			// underlying mechanism this uses -- nothing sitar_model-
			// specific about it).
			//
			// ||
			// 	do
			// 		wait until (this_phase==0);
			// 		$
			// 		bool inTimeWindow = current_time.cycle() >= 1000 && current_time.cycle() < 2000;
			// 		bool inPCRange    = sparcThread.core.reg.R_PC() >= 0x2000 && sparcThread.core.reg.R_PC() < 0x2100;
			// 		if (inTimeWindow && inPCRange)
			// 			sparcThread.log.turnON();
			// 		else
			// 			sparcThread.log.turnOFF();
			// 		$;
			// 		// A real, time-consuming wait, not just the
			// 		// phase-aligning one above: without this, this loop
			// 		// never actually lets simulated time advance (`wait
			// 		// until` returns immediately once its condition is
			// 		// already true, which it is again on the very next
			// 		// iteration), spinning at the same instant forever --
			// 		// hits Sitar's iteration-limit safety net almost
			// 		// immediately. One cycle is plenty; this only needs
			// 		// to re-check once per cycle.
			// 		wait(1,0);
			// 	while (1) end do;
		]
	end behavior
end module
