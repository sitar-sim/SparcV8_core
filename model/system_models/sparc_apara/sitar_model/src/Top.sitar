//
// The top-level module Sitar requires for `sitar compile`. It looks for
// a module literally named Top. Just instantiates System. Kept as its
// own file rather than folded into System.sitar so that System stays a
// reusable submodule.
//================================================================

module Top
	submodule system : System
end module
