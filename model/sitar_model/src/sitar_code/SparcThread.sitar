
//================================================================
// procedure SparcThread
// Author: Neha Karanjkar
//
// The SPARC V8 fetch-decode-execute-trap state machine (Ref Appendix
// C.5), implemented as a procedure. Drives a SparcCore instance (the
// timing-agnostic ISA/state library, see cpp_common_code/SparcCore.h)
// through RESET/EXECUTE/ERROR, dispatching to it every cycle; owns 5
// MemoryInterface instances (ifetch/read/write/atomic/flush) that carry
// out the actual memory-referencing side of each instruction.
//
// Conventions:
//
//	Exactly like the plain C++ model (model/cpp_model/SparcStateMachine):
//	a trap that occurs while traps are disabled (ET==0) has no handler
//	left to jump to, so SparcCore::selectTrap() puts the core into
//	error_mode instead -- that is the one and only way this procedure
//	halts (HALT.VALUE, below). There is nothing special about any
//	particular trap number; this procedure makes no judgment about
//	whether a given halt represents a passing or failing test. That
//	verdict comes from comparing final register/memory state against a
//	test's own expected-results file (see sitar_check_test.cpp, which
//	waits for HALT.VALUE and then does exactly that -- same convention
//	as check_test.cpp for the cpp model).
//================================================================


procedure SparcThread

	//interface
	//-----------------------------------------------------

	//status flag HALT -- see the "Conventions" note above: this procedure
	//tracks only whether the core has halted, never why.
	decl
	$
	#define cache_line_size_on_host  64
	typedef struct  __attribute__ ((aligned (cache_line_size_on_host))) {
	bool VALUE;
	char pad[cache_line_size_on_host - sizeof(bool)];
	} PaddedBlock;

	PaddedBlock HALT;

	$
	init
	$
	HALT.VALUE = false;
	$

	//processor and core ID for this core
	//default IDs are 0,0
	decl
	$
	uint32_t processorID;
	uint32_t coreID;

	void 		setProcessorID(unsigned int id)
			{
			          processorID=id;
			          core.setProcessorID(id);

			  ifetchThread.processorID	   =id;
			 memReadThread.processorID	   =id;
			memWriteThread.processorID	   =id;
			atomicLoadStoreThread.processorID  =id;
			     flushThread.processorID  =id;
			};

	unsigned int 	getProcessorID(){return processorID;};

	void 		setCoreID(unsigned int id)
			{
			          coreID=id;
			          core.setCoreID(id);

			  ifetchThread.coreID = id;
			 memReadThread.coreID = id;
			memWriteThread.coreID = id;
			atomicLoadStoreThread.coreID=id;
			     flushThread.coreID=id;
			};


	unsigned int 	getCoreID(){return coreID;};
	$
	init $processorID=0;coreID=0;$
	//------------------------------------------------------------




	//procedures used for memory interfacing.
	//
	//These are deliberately Sitar *procedures* (called synchronously via
	//`run`), not modules connected by ports/nets: a procedure call can
	//complete within the same cycle it started (0-delay), whereas a
	//module-to-module net enforces Sitar's minimum 1-cycle latency on
	//every hop. Any latency for these memory references is instead
	//modeled explicitly, as an actual `wait`, inside MemoryInterface
	//itself (see its `delay` parameter) -- not as an incidental side
	//effect of the connection style. Keep it this way even as caches are
	//added later: give MemoryInterface a nonzero delay rather than
	//switching these to modules/ports.
	procedure ifetchThread   : MemoryInterface  //should be linked to I cache OR main memory to model 0-delay ifetch
	procedure memReadThread  : MemoryInterface  //should be linked to D cache
	procedure memWriteThread : MemoryInterface  //should be linked to D cache
	procedure atomicLoadStoreThread : MemoryInterface
	procedure flushThread    : MemoryInterface  //conveys FLUSH to whatever is connected (a cache/memory etc)


	//initialize memory interface procedures
	init
	$
	ifetchThread.memoryAccessType   = MemAccessType::IFETCH;
	memReadThread.memoryAccessType  = MemAccessType::LOAD;
	memWriteThread.memoryAccessType = MemAccessType::STORE;
	atomicLoadStoreThread.memoryAccessType = MemAccessType::ATOMIC_LS;
	flushThread.memoryAccessType    = MemAccessType::FLUSH;
	$


	include
	$
	#include"SparcCore.h"
	#include"OpcodeLatencies.h"
	#include"DebugHooks.h"
	$



	//===============================================================================================================
	// 					state machine for Sparc Core
	//===============================================================================================================
	behavior
			decl
			$
			SparcCore 	core;
			uint32_t 	instruction;
			Opcode 		opcode;
			bool		RESET_pin;
			uint32_t	opcode_delay;	//per-instruction latency, from OpcodeLatencies.h
			$;

			//RESET_pin is used to cause external reset. By default, RESET_pin is always low.
			//Processor starts in RESET state and immediately goes to EXECUTE state.
			//To RESET processor at any time externally,  set RESET_pin to true

			init
			$
			RESET_pin = 0;
			core.state=SparcCore::RESET;
			$;


			do
				//======================================================
				//RESET
				//======================================================
				if(core.state==SparcCore::RESET)then
					wait until (RESET_pin==0 and this_phase==0);
					$
					core.state=SparcCore::EXECUTE;
					core.trap=1;
					core.reset_trap=1;
					log<<endl<<core.logger.log_generic(current_time.cycle(), "RESET", "reset_trap -> EXECUTE");
					$;
				end if;


				//======================================================
				//ERROR
				//======================================================
				if(core.state==SparcCore::ERROR)then

					//core enters ERROR state after any trap occurs while
					//traps are disabled (ET==0) -- see the "Conventions"
					//note at the top of this file. Just record the halt;
					//pass/fail is decided externally.

					wait until (this_phase==0);
					$
					HALT.VALUE = true;
					log<<endl<<core.logger.log_generic(current_time.cycle(), "HALT", "entering error_mode");
					$;

					//This procedure's own loop (below) never exits once
					//state==ERROR, so without a real time-consuming wait
					//here it would spin through this branch again and
					//again at the same simulated instant, starving every
					//other parallel branch -- including Core.sitar's
					//monitor branch, the thing actually responsible for
					//calling `stop simulation;` once it sees HALT.VALUE.
					//One cycle is enough: the monitor checks every cycle.
					wait(1,0);

				end if;




				//======================================================
				//EXECUTE
				//======================================================
				//Each iteration: fetch-decode-execute one instruction, then
				//wait(opcode_delay, 0) -- no phase bracketing needed, since
				//wait(c, 0) never changes phase, and we enter this loop at
				//phase 0 (guaranteed by the RESET state above), so every
				//iteration stays at phase 0 by construction.
				if(core.state==SparcCore::EXECUTE)then
					do
						//if reset is asserted, exit the EXECUTE loop
						if(RESET_pin==1) then
							$core.state=SparcCore::RESET;$;
							$log<<endl<<"Entering RESET state from EXECUTE state";$;
						end if;



						//check for traps
						if(core.state==SparcCore::EXECUTE)then
							$
							//Check for external traps(on the processor pins)
							//if traps are enabled and unmasked traps
							//have occured, set trap=1
							core.checkExternalTraps();
							//Either the checking of processor pins in this
							//cycle, or execution of the previous
							//instruction might have caused a trap.
							//if so, execute traps.
							if(core.trap==1)
							{
								//Read core.printTrap() before executeTraps() -- it
								//clears every trap-cause flag as soon as this trap
								//is serviced (SparcCore::selectTrap()), so this is
								//the last point they're still valid to read.
								log<<endl<<core.logger.log_trap_raised(current_time.cycle());
								debug_hook_trap_raised(core);

								//Ref Section C.5: "if (trap = 1) then execute_trap;" --
								//unconditional, every trap is dispatched the same way;
								//there is no special-casing by trap type here.
								//executeTraps() (Ref Section C.8, select_trap) decides
								//internally whether to enter error_mode itself (only
								//when traps are disabled, ET==0, so there is no handler
								//left to jump to) or dispatch normally to the trap
								//table -- so core.state is only checked *after* the call,
								//never decided here beforehand.
								core.executeTraps();

								if (core.state==SparcCore::EXECUTE)
									log<<endl<<core.logger.log_trap_enter(current_time.cycle());
							};
							$;
						end if;


						if(core.state==SparcCore::EXECUTE)then
							//Instruction fetch
							$
							//read instruction from the address formed by PC and addr_space
							//and store the fetched instruction in core.reg.instruction.
							//Set bit MAE if there was a memory access exception
							if(core.reg.R_S() ==0)
								ifetchThread.addr_space=8; //user-mode
							else
								ifetchThread.addr_space=9; //supervisor-mode
							ifetchThread.address = core.reg.R_PC();
							$;

							//wait until instruction fetch finishes
							run ifetchThread;



							//examine the fetched instruction
							$
							core.MAE = ifetchThread.MAE;
							debug_hook_mem_access(core, DebugMemAccessKind::IFETCH, core.reg.R_PC(), ifetchThread.instruction, 0);
							//check for instruction access exception
							if(  (ifetchThread.MAE == 1) && (core.annul == 0) )
							{
								core.trap=1;
								core.instruction_access_exception=1;
							}
							$;

							if(core.state==SparcCore::EXECUTE and core.trap==0) then
								//decode and execute the current instruction
								$
								instruction=ifetchThread.instruction;
								core.reg.W_instruction(instruction);
								opcode=core.decoder.decode(&core.reg);

								log<<endl<<core.logger.log_fetch(current_time.cycle(), opcode);
								$;


								//Check if this instruction is to be anulled
								if(core.annul==1) then
									//Do not execute this instruction.
									//just proceed to the next one.
									//Hook fires before PC/nPC are
									//overwritten below -- see
									//DebugHooks.h's own comment -- so
									//core.reg.PC/nPC here are still the
									//annulled instruction's own address
									//and what it advances to.
									$
									core.annul=0;
									log<<endl<<core.logger.log_generic(current_time.cycle(), "ANNUL", "instruction annulled");
									debug_hook_annulled(core);
									core.reg.W_PC(core.reg.R_nPC()); //PC=nPC
									core.reg.W_nPC(core.reg.R_nPC()+4); //nPC=nPC+4;
									$;
								else
									//this instruction is to be executed

									//check for instruction-related exceptions
									//such as Illegal or UNIMP instructions
									$
									core.checkInstructionException(opcode);
									$;



									if(core.state==SparcCore::EXECUTE and core.trap==0) then

										//===========================
										//Execute the instruction
										//===========================
										if(not(isMemoryInstruction(opcode))) then
											//if not a memory instruction,
											//execute it in one cycle
											$
											//Execute Instruction
											core.executeInstruction(opcode);
											//complete Floating point residual operations
											if(core.trap==0 and (isFpop1Instruction(opcode)\
											or isFpop2Instruction(opcode)) )
											{
												core.complete_fp_execution(opcode);
											}
											$;
										else

											//if this is a memory-instruction,
											//execute it


											//LOAD
											if(isLoadInstruction(opcode)) then
												//Calculate address and addr_space from the opcode
												//and check for traps
												$core.execute_PreLoad(opcode);$;

												if(core.trap==0) then
													//perform Read using memReadThread.
													$
													memReadThread.address=core.address;
													memReadThread.addr_space=core.addr_space;
													$;

													run memReadThread;

													$
													core.MAE=memReadThread.MAE;
													core.readWord0=memReadThread.readWord0;
													core.readWord1=memReadThread.readWord1;
													core.execute_PostLoad(opcode, core.readWord0, core.readWord1);
													log<<endl<<core.logger.log_mem_read(current_time.cycle(), core.address, core.readWord0, core.readWord1, isDoubleLoadInstruction(opcode), core.MAE);
													debug_hook_mem_access(core, DebugMemAccessKind::LOAD, core.address, core.readWord0, core.readWord1);
													$;
												end if;
											end if;


											//STORE
											if(isStoreInstruction(opcode)) then
													//calculate address from the opcode
													//word0, word1, byte_mask
													//check for traps
													$
													core.execute_PreStore(opcode);
													$;

													if(core.trap==0) then
														//Write to memory using write thread
														$
														memWriteThread.address	 	=core.address;
														memWriteThread.addr_space	=core.addr_space;
														memWriteThread.writeWord0       =core.writeWord0;
														memWriteThread.writeWord1       =core.writeWord1;
														memWriteThread.byte_mask 	=core.byte_mask;
														$;

														run memWriteThread;

														$
														log<<endl<<core.logger.log_mem_write(current_time.cycle(), core.address, core.writeWord0, core.writeWord1, core.byte_mask, memWriteThread.MAE);
														debug_hook_mem_access(core, DebugMemAccessKind::STORE, core.address, core.writeWord0, core.writeWord1);
														$;

													end if;
											end if;

											//ATOMIC LOADS STORES
											if(isLoadStoreAtomicInstruction(opcode)) then
												//Calculate address and addr_space from the opcode
												//and check for traps
												$core.execute_PreAtomicLoadStore(opcode);$;

												if(core.trap==0) then
													//perform Read using atomicLoadStoreThread
													$
													atomicLoadStoreThread.address=core.address;
													atomicLoadStoreThread.addr_space=core.addr_space;
													atomicLoadStoreThread.writeWord0 = core.writeWord0;
													atomicLoadStoreThread.writeWord1 = core.writeWord1;
													atomicLoadStoreThread.byte_mask  = core.byte_mask;
													$;

													run atomicLoadStoreThread;

													$
													core.MAE=atomicLoadStoreThread.MAE;
													core.readWord0=atomicLoadStoreThread.readWord0;
													core.readWord1=atomicLoadStoreThread.readWord1;
													core.execute_PostAtomicLoadStore(opcode, core.readWord0, core.readWord1);
													log<<endl<<core.logger.log_atomic(current_time.cycle(), core.address, core.readWord0, core.writeWord0, core.MAE);
													debug_hook_mem_access(core, DebugMemAccessKind::ATOMIC, core.address, core.readWord0, core.writeWord0);
													$;
												end if;
											end if;


											if(opcode==FLUSH) then
												//Calculate address (Ref Appendix B.32); no traps are
												//defined for FLUSH once implemented.
												$core.execute_PreFlush(opcode);$;

												//Convey the flush onward. In direct-interface mode
												//(no cache connected) this is a no-op; once a cache is
												//ported, flushThread's port-based branch is where the
												//request gets forwarded to it.
												$
												flushThread.address=core.address;
												flushThread.addr_space=core.addr_space;
												$;

												run flushThread;

												$
										log<<endl<<core.logger.log_generic(current_time.cycle(), "FLUSH", "");
										debug_hook_mem_access(core, DebugMemAccessKind::FLUSH, core.address, 0, 0);
										$;
											end if;
										end if;

										//Instruction fully executed, PC/nPC not yet advanced --
										//see DebugHooks.h/CoreLogger.h's file comments for why
										//this exact point.
										$
										log<<endl<<core.logger.log_execute(current_time.cycle(), opcode);
										debug_hook_after_execute(core, opcode);
										$;

										// update PC and nPC if this is not a branch instruction
										if(core.trap==0 and not(isBranchInstruction(opcode))) then
											$
											core.reg.W_PC(core.reg.R_nPC()); //PC=nPC
											core.reg.W_nPC(core.reg.R_nPC()+4); //nPC=nPC+4;
											$;
										end if;
									end if;

									//Opcode-wise per-instruction latency (see OpcodeLatencies.h),
									//charged whether this instruction was executed or annulled.
									//For a memory instruction, the effective total latency is the
									//sum of this, MemoryInterface.delay, and MainMemory.delay.
									$opcode_delay = getOpcodeLatency(opcode);$;
									wait(opcode_delay, 0);
								end if;
							end if;



						end if;
					while (core.state==SparcCore::EXECUTE) end do;
				end if;
			while (1) end do;
	end behavior
	decl
	$
	std::string printInfo()
	{

		std::stringstream ss;

		ss<<"\n ----------------------------------------------------------";
		ss<<"\n Processor "<<hierarchicalId()<<" halted";
		ss<<" -- last instruction executed :"<<printOpcode(opcode);
		ss<<" at address      : 0x"<<std::hex<<ifetchThread.address<<std::dec;
		ss<<"\n trap status = "<<core.trap;
		ss<<"\n-----------------------------";
		ss<<"\n\n Memory accesses:";
		ss<<"\n-----------------------------";
		ss<<"\n Instruction fetches:";
		ss<<"\n\t total references = "<<ifetchThread.numAccesses;
		ss<<"\n\t avg latency      = "<<(double(ifetchThread.totalLatency)/double(ifetchThread.numAccesses));
		ss<<"\n";

		ss<<"\n Mem READS:";
		ss<<"\n\t total references = "<<memReadThread.numAccesses;
		ss<<"\n\t avg latency      = "<<(double(memReadThread.totalLatency)/double(memReadThread.numAccesses));
		ss<<"\n";

		ss<<"\n Mem WRITES:";
		ss<<"\n\t total references = "<<memWriteThread.numAccesses;
		ss<<"\n\t avg latency      = "<<(double(memWriteThread.totalLatency)/double(memWriteThread.numAccesses));
		ss<<"\n";

		ss<<"\n Atomic Loads/Stores:";
		ss<<"\n\t total references = "<<atomicLoadStoreThread.numAccesses;
		ss<<"\n\t avg latency      = "<<(double(atomicLoadStoreThread.totalLatency)/double(atomicLoadStoreThread.numAccesses));
		ss<<"\n";

		return ss.str();

	}
	$
end procedure
