
//================================================================
// procedure MemoryInterface
// Author: Neha Karanjkar
//
// A minimal, blocking memory-access interface, called synchronously
// (via `run`) by SparcThread's ifetch/load/store/atomic/flush threads --
// see SparcThread.sitar for why these are procedure calls and not
// module/port connections. Each `run` performs exactly one access and
// returns; the procedure instance itself is not destroyed and is reused
// for the next access (no loop of its own -- contrast with MainMemory,
// which is persistent).
//
// Holds no memory storage and no direct pointer to it. Instead it talks
// to whatever persistent procedure is connected on the other end (today,
// MainMemory; later, a cache) through one MemAccessInterface object --
// see MemAccessInterface.h for the full request/response handshake this
// implements (this procedure is the requester's half of it).
//
// NOTE:
//	all accesses are double word accesses.
//	address must be double word aligned.
//	For writes: a byte mask is used to write to a specific set of
//	bytes in the double word.
//================================================================


procedure MemoryInterface

	//--------------------------------------------------------
	//Fields to be set by processor at start:
	//--------------------------------------------------------
	decl
	$
	//processor and core IDS to be set by parent module at start
	uint32_t processorID;
	uint32_t coreID;

	//which kind of access this instance performs -- fixed for the
	//lifetime of the instance (e.g. SparcThread's memReadThread is
	//always LOAD), set once by the parent module's init.
	MemAccessType memoryAccessType;

	//total number of requests made by this procedure
	uint64_t requestCount;
	$
	init
	$
		processorID=0;
		coreID=0;
		memoryAccessType = MemAccessType::NO_ACCESS;
		requestCount = 0;
	$

	//--------------------------------------------------------
	//Access latency, modeled on the core side of this interface.
	//--------------------------------------------------------
	//
	//Cycles only (not phases): the number of *extra* cycles this
	//procedure blocks its caller for, beyond the 0-delay procedure-call
	//semantics it would otherwise have. Default 0. Lets a directly
	//connected MainMemory (or, later, a cache) have an access latency
	//approximated here without that latency needing to be modeled by the
	//connected procedure itself. Independent of, and in addition to, the
	//opcode-wise per-instruction delay applied in SparcThread (see
	//OpcodeLatencies.h).
	decl$uint32_t delay;$
	init$delay = 0;$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Input and output variables for each memory access
	//--------------------------------------------------------
	decl
	$
	uint32_t address;     //address to be accessed
	uint32_t addr_space;  //currently ignored. Will be used when virtual memory is implemented

	uint32_t readWord0;
	uint32_t readWord1;
	uint32_t writeWord0;
	uint32_t writeWord1;
	uint32_t instruction;
	uint32_t byte_mask;
	bool 	 MAE;
	$
	init
	$
	address    =0;
	addr_space =0;
	readWord0  =0;
	readWord1  =0;
	writeWord0 =0;
	writeWord1 =0;
	byte_mask  =0;
	MAE        =0;
	$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Stats collection
	//--------------------------------------------------------
	decl
	$
	long unsigned int numAccesses;  //total number of mem accesses finished
	long double 	  totalLatency; //sum of latencies of all accesses (cycles)

	//start time of the access currently in flight
	long unsigned int startTime;
	$
	init
	$
	numAccesses=0;
	totalLatency=0;
	$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Connection to whatever is servicing this interface (MainMemory, or
	//later a cache) -- see MemAccessInterface.h for the protocol.
	//--------------------------------------------------------

	include
	$
	#include"MemAccessInterface.h"
	$

	decl
	$
	MemAccessInterface* interface;   //set by parent module's init
	$
	init
	$
	interface = NULL;
	$
	//--------------------------------------------------------


	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
behavior

	//check that this instance has been initialized by the parent module
	//correctly before making any request
	$
	assert(memoryAccessType!=MemAccessType::NO_ACCESS);
	assert(interface);
	$;

	//wait until whatever is servicing this interface is free, then issue
	//the request (see MemAccessInterface.h step 1)
	wait until (this_phase==0 and not($interface->request_valid$));

	$
	startTime = current_time.cycle();
	log<<endl<<"[t="<<current_time<<"] Started memory reference of type "<<accessTypeToString(memoryAccessType)
	   <<" for address 0x"<<std::hex<<address<<std::dec;

	interface->access_type = memoryAccessType;
	interface->address     = address;
	interface->addr_space  = addr_space;
	interface->writeWord0  = writeWord0;
	interface->writeWord1  = writeWord1;
	interface->byte_mask   = byte_mask;
	interface->request_valid = true;
	$;

	//wait for the response (the access_type check is a cheap consistency
	//check -- see MemAccessInterface.h step 3)
	wait until (this_phase==0 and $interface->response_valid and interface->access_type==memoryAccessType$);

	$
	readWord0   = interface->readWord0;
	readWord1   = interface->readWord1;
	instruction = interface->instruction;
	MAE         = interface->MAE;

	//close the transaction: frees the responder to service the next
	//request, and frees this (or another) interface to issue one
	interface->request_valid  = false;
	interface->response_valid = false;
	$;

	//model the configured access latency (default 0 -- see `delay` above)
	if ($delay > 0$) then
		wait(delay, 0);
	end if;

	$
	requestCount++;
	numAccesses++;
	totalLatency += double(current_time.cycle() - startTime);

	log<<endl<<"[t="<<current_time<<"] Finished memory reference of type "<<accessTypeToString(memoryAccessType)
	   <<" for address 0x"<<std::hex<<address<<std::dec;
	if(memoryAccessType==MemAccessType::IFETCH) log<<"  Fetched instruction word 0x"<<std::hex<<instruction<<std::dec;
	$;


	nothing;

end behavior
end procedure

