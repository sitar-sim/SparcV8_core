//================================================================
// module AparaEngine
// Original author: Madhav Desai, IITB
// Model Author: Claude Opus 5.5 (high)
// This model code was adapted from the APARA engine specification and
// reference C implementation developed by Prof. Madhav Desai, IITB
//
// One APARA engine's thread execution unit: the five pipeline stages,
// each a module, joined by nets with the channel depths of the
// hardware's teu.hsys (Ref the APARA microarch doc's channel table):
//
//   fetch -> decode -> regfile (one channel per thread) -> exec
//   exec -> regfile       results: REGFILE releases the bundle's locks
//   regfile -> writeback  results, on to retire
//   writeback -> fetch    PC correction, halt notification
//   exec -> fetch         thread start and reset (in a system: the
//                         control unit's commands, carried out by EXEC)
//
// In a system, exec's service, off-island and stop ports connect to the
// engine's host side (AparaHost), from the module above (Ref
// AparaExec.sitar's hostConnected).
//
// Every net crossing takes Sitar's one cycle, so a bundle spends at least
// one cycle in each stage, as in the hardware's elastic pipeline.
//
// The functional engine state is exec.core (Ref AparaExec.sitar); fetch
// reads IMEM from it and decode uses exec's latency table, both only
// read during a run.
//================================================================

module AparaEngine

	include
	$
	#include "AparaTiming.h"
	$

	submodule fetch     : AparaFetch
	submodule decode    : AparaDecode
	submodule regfile   : AparaRegfile
	submodule exec      : AparaExec
	submodule writeback : AparaWriteback

	net       fetchToDecode      : capacity 2 width APARA_BUNDLE_TOKEN_BYTES
	net_array decodeToRegfile[4] : capacity 2 width APARA_BUNDLE_TOKEN_BYTES
	net       regfileToExec      : capacity 2 width APARA_BUNDLE_TOKEN_BYTES
	net       execToRegfile      : capacity 1 width APARA_RESULT_TOKEN_BYTES
	net       regfileToWriteback : capacity 2 width APARA_RESULT_TOKEN_BYTES
	net       correctionNet      : capacity 1 width APARA_CORRECTION_TOKEN_BYTES
	net       haltNet            : capacity 1 width APARA_HALT_TOKEN_BYTES
	net       fetchControlNet    : capacity 2 width APARA_FETCH_CONTROL_BYTES

	fetch.toDecode       => fetchToDecode
	decode.fromFetch     <= fetchToDecode
	for i in 0 to 3
		decode.toRegfile[i]  => decodeToRegfile[i]
		regfile.fromDecode[i] <= decodeToRegfile[i]
	end for
	regfile.toExec       => regfileToExec
	exec.fromRegfile     <= regfileToExec
	exec.toRegfile       => execToRegfile
	regfile.fromExec     <= execToRegfile
	regfile.toWriteback  => regfileToWriteback
	writeback.fromRegfile <= regfileToWriteback
	writeback.correctionOut => correctionNet
	fetch.correctionIn   <= correctionNet
	writeback.haltOut    => haltNet
	fetch.haltIn         <= haltNet
	exec.fetchControlOut => fetchControlNet
	fetch.controlIn      <= fetchControlNet

	decl
	$
	public:
	//Start thread t at pc: in the functional state and in FETCH.
	void startThread(unsigned int t, uint32_t pc)
	{
		exec.core.startThread(t, pc);
		fetch.startThread(t, pc);
	}

	apara::AparaTimingStats stats() const
	{
		apara::AparaTimingStats s;
		s.add(fetch.stats);
		s.add(regfile.stats);
		s.add(exec.stats);
		return s;
	}
	$

	init
	$
	fetch.imem = &exec.core;
	decode.latency = &exec.latency;
	$
end module
