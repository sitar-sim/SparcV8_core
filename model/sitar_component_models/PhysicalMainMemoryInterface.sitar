
//================================================================
// procedure PhysicalMainMemoryInterface
// Author: Neha Karanjkar
//
// Mmu's own physical-access transaction procedure. Mmu owns two
// instances, phyMemReadProcedure and phyMemWriteProcedure, with
// accessType fixed to READ/WRITE respectively at init.
//
// Reaches PhysicalMainMemory over nets: nests two single-token I/O
// procedures, sendPhyMemRequest and getPhyMemResponse, and packs or
// unpacks its own request/response fields into their tokens around
// each `run`. `reqPortPtr`/`respPortPtr` are set by an ancestor module
// (Core.sitar), which owns the real ports, then handed straight to
// these nested instances at this procedure's own init.
//
// Named PhysicalMainMemoryInterface rather than PhysicalMemoryInterface
// to avoid this procedure sharing a name with the plain C++
// PhysicalMemoryInterface class it and PhysicalMainMemory both
// implement.
//================================================================

procedure PhysicalMainMemoryInterface

	//--------------------------------------------------------
	//Fields to be set by the parent procedure at start:
	//--------------------------------------------------------
	decl
	$
	//which kind of access this instance performs -- fixed for the
	//lifetime of the instance (e.g. Mmu's phyMemReadProcedure is always
	//READ), set once by the parent's init.
	PhysicalAccessType accessType;

	//total number of requests made by this procedure
	uint64_t requestCount;
	$
	init
	$
		accessType = PhysicalAccessType::READ;
		requestCount = 0;
	$

	//--------------------------------------------------------
	//Access latency, modeled on the MMU side of this interface -- the
	//interconnect between the MMU and whatever services it. Independent
	//of, and additive with, PhysicalMainMemory's own service-time delay,
	//exactly like VirtualMainMemoryInterface.delay/VirtualMainMemory.delay
	//are on the virtual side, and with the >=1 cycle minimum latency
	//sendPhyMemRequest/getPhyMemResponse's own nets add crossing the
	//module boundary either way (Ref System.sitar's own comment on that).
	//--------------------------------------------------------
	decl$uint32_t delay;$
	init$delay = 0;$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//This procedure's own public request/response state. The caller
	//(Mmu.sitar) is responsible for setting *every* one of
	//request.physicalAddress/data/byteMask/lock explicitly before each
	//`run` -- this instance is reused across calls (Ref Sitar's own
	//"re-activated automatically" semantics: a run procedure's state
	//does not auto-reset between calls, so a field the caller forgot to
	//set would silently carry over from whatever the *previous*,
	//possibly unrelated, transaction left there), not just the fields
	//relevant to the immediate access type.
	//
	//response.valid is deliberately never set or read here -- the
	//caller relies on `run` itself blocking until this procedure fully
	//terminates, exactly the same convention VirtualMainMemoryInterface.sitar's
	//own header comment documents for its local response.valid ("simply
	//never touched... correct today").
	//--------------------------------------------------------
	include
	$
	#include"MemoryInterfaces.h"
	$

	decl
	$
	PhysicalMemoryRequest  request;
	PhysicalMemoryResponse response;
	$
	init
	$
	request.valid           = false;
	request.accessType      = PhysicalAccessType::READ;
	request.lock            = false;
	request.physicalAddress = 0;
	request.data            = 0;
	request.byteMask        = 0;

	response.valid    = false;
	response.readData = 0;
	response.mae      = false;
	$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//Connection to whatever is servicing this interface (PhysicalMainMemory
	//today), reached over nets rather than a direct procedure handshake.
	//reqPortPtr/respPortPtr are set by an ancestor module (Core.sitar,
	//not this procedure's own immediate parent Mmu) at that module's own
	//init -- Ref this file's header comment. This procedure's own init
	//(below) then hands them straight to sendPhyMemRequest/
	//getPhyMemResponse, so nothing here ever calls ptr->push/pull
	//directly.
	//--------------------------------------------------------
	decl
	$
	outport<TOKEN_REQ_WIDTH>*  reqPortPtr;
	inport<TOKEN_RESP_WIDTH>*  respPortPtr;
	$
	init
	$
	reqPortPtr  = NULL;
	respPortPtr = NULL;
	$

	procedure sendPhyMemRequest : PushAToken<TOKEN_REQ_WIDTH>
	procedure getPhyMemResponse : PullAToken<TOKEN_RESP_WIDTH>
	//--------------------------------------------------------

	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
	behavior

	$
	assert(reqPortPtr);
	assert(respPortPtr);
	sendPhyMemRequest.ptr = reqPortPtr;
	getPhyMemResponse.ptr = respPortPtr;
	$;

	$
	log<<endl<<"[t="<<current_time<<"] Started physical memory reference of type "
	   <<(accessType==PhysicalAccessType::READ ? "READ" : "WRITE")
	   <<" for address 0x"<<std::hex<<request.physicalAddress<<std::dec;

	sitar::pack(sendPhyMemRequest.tok, accessType, request.lock,
	            request.physicalAddress, request.data, request.byteMask);
	$;

	run sendPhyMemRequest;

	run getPhyMemResponse;

	$
	sitar::unpack(getPhyMemResponse.tok, response.readData, response.mae);
	$;

	if ($delay > 0$) then
		wait(delay, 0);
	end if;

	$
	requestCount++;
	log<<endl<<"[t="<<current_time<<"] Finished physical memory reference for address 0x"
	   <<std::hex<<request.physicalAddress<<std::dec;
	$;

	nothing;

	end behavior
end procedure
