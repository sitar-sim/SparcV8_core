//================================================================
// module PeripheralDevices
// Author: Neha Karanjkar
//
// The system's single shared set of peripheral devices (Timer, Serial,
// Interrupt Controller), as a module on the physical bus. Embeds the
// plain C++ PeripheralDevicesCore unchanged (field `devices`), which
// already does all device behavior, pin wiring, and doubleword-to-
// register adaptation, the same class the cpp_model uses (Ref
// PeripheralDevicesCore.h). This module only adds timing and the
// connections to the rest of the system. Named PeripheralDevices rather
// than PeripheralDevicesCore so the module never shares a name with the
// C++ class it embeds.
//
// A module, not a procedure, because the device set is shared by every
// core, so it has to be reachable over nets (and, once there are several
// cores, run in parallel with them).
//
// Two things happen concurrently, so the behavior is a parallel block:
//   - the clock: devices.tick() once per cycle in phase 0, then, in
//     phase 1, each core's interrupt level (its thread 0 slot) is pushed
//     onto interruptLevelOut[core] whenever it changes (a level, not an
//     event: the receiver keeps the last value it pulled);
//   - register accesses: one request at a time from requestIn, serviced
//     through devices.access(), answered on responseOut after
//     registerAccessDelay extra cycles (default 0).
//
// Each net crossing costs at least one cycle, so an interrupt reaches
// the core one cycle after the device raises it. That is accepted
// here, the same way device register accesses cost a net round trip.
//================================================================

module PeripheralDevices

	include
	$
	#include "MemoryInterfaces.h"
	#include "PeripheralDevicesCore.h"
	#include "InterruptControllerCore.h"
	$

	inport  requestIn         : width TOKEN_REQ_WIDTH
	outport responseOut       : width TOKEN_RESP_WIDTH

	//The interrupt level (IRL, 0..15, one byte) for each core's thread 0
	//slot (slot = 2*core_id, Ref InterruptControllerCore.h), one output
	//per core the Interrupt Controller has slots for. A configuration
	//connects only its own cores' outputs (a single-core one, just
	//interruptLevelOut[0]). The others are left unconnected and never
	//pushed.
	outport_array interruptLevelOut[4] : width 1
	//The Interrupt Controller's external input (IRL 14), from an APARA
	//engine in sparc_apara; optional: unconnected in the other
	//configurations. A token carries the new level (0 or 1).
	inport  externalInterruptIn : width 1

	procedure getRequest   : PullAToken<TOKEN_REQ_WIDTH>
	procedure sendResponse : PushAToken<TOKEN_RESP_WIDTH>

	init
	$
	getRequest.ptr   = &requestIn;
	sendResponse.ptr = &responseOut;
	$

	decl
	$
	PeripheralDevicesCore devices;

	PhysicalMemoryRequest  request;
	PhysicalMemoryResponse response;

	//Cycles added to every register access, between servicing it and
	//sending the response. Default 0.
	uint32_t registerAccessDelay;

	static const int MAX_CORES = 4; //interruptLevelOut's size
	uint8_t   lastSentLevel[MAX_CORES];
	token<1>  levelToken;
	token<1>  externalToken;
	$
	init
	$
	request.valid           = false;
	request.accessType      = PhysicalAccessType::READ;
	request.lock            = false;
	request.physicalAddress = 0;
	request.data            = 0;
	request.byteMask        = 0;

	response.valid    = false;
	response.readData = 0;
	response.mae      = false;

	registerAccessDelay = 0;
	for (int c = 0; c < MAX_CORES; c++)
		lastSentLevel[c] = 0;
	$

	behavior
	[
		//The clock.
		do
			wait until (this_phase==0);
			$
			if (externalInterruptIn.getNet() && externalInterruptIn.pull(externalToken))
			{
				uint8_t level = 0;
				sitar::unpack(externalToken, level);
				devices.externalInterruptIn = level != 0;
			}
			devices.tick();
			$;

			wait until (this_phase==1);
			$
			for (int c = 0; c < MAX_CORES; c++)
			{
				if (!interruptLevelOut[c].getNet())
					continue;
				uint8_t level = (uint8_t) devices.interruptLevel(InterruptControllerCore::slotIndex(c, 0));
				if (level != lastSentLevel[c])
				{
					sitar::pack(levelToken, level);
					//If the net is still full, the push fails and is simply
					//retried on the next cycle.
					if (interruptLevelOut[c].push(levelToken))
						lastSentLevel[c] = level;
				}
			}
			$;
		while(1) end do;
	||
		//Register accesses.
		do
			run getRequest;

			$
			sitar::unpack(getRequest.tok, request.accessType, request.lock,
			              request.physicalAddress, request.data, request.byteMask);
			devices.access(request, response);
			$;

			if ($registerAccessDelay > 0$) then
				wait(registerAccessDelay, 0);
			end if;

			$ sitar::pack(sendResponse.tok, response.readData, response.mae); $;
			run sendResponse;
		while(1) end do;
	]
	end behavior
end module
