
//================================================================
// procedure VirtualMainMemoryInterface
// Author: Neha Karanjkar
//
// A minimal, blocking memory-access interface, called via `run` by
// SparcThread's ifetch, load, store, atomic, and flush procedures. Each
// `run` performs exactly one access. The instance is reused for the
// next one, not destroyed.
//
// Named VirtualMainMemoryInterface rather than VirtualMemoryInterface,
// which would exactly match the abstract C++ interface class of that
// name in MemoryInterfaces.h.
//
// `request`/`response` (VirtualMemoryRequest/VirtualMemoryResponse) are
// this procedure's own public state. The caller sets request fields
// directly, then calls `run`, then reads the response fields.
//
// Talks to whatever persistent procedure is on the other end
// (VirtualMainMemory for core_only, Mmu for core_mmu) through
// `downstreamRequest`/`downstreamResponse`: pointers into that
// procedure's own local request/response fields, wired up by the parent
// module at init. This procedure holds no separate copy of that state.
//
// `valid` ownership:
//
// - `downstreamRequest->valid` is set by this procedure, cleared by
//   this procedure once the response is consumed.
// - `downstreamResponse->valid` is set by whatever services it, cleared
//   by this procedure.
// - `request.valid`/`response.valid` are unused today. They exist for a
//   future persistent procedure calling this one through the same
//   fields, instead of SparcThread's direct set-then-run convention.
//
// Payload fields are copied individually between `request`/`response`
// and `*downstreamRequest`/`*downstreamResponse`, never by whole-struct
// assignment, so each `valid` bit stays owned by whoever the rule above
// says owns it.
//
// All accesses are doubleword accesses. The address must be doubleword
// aligned.
//	For writes: a byte mask is used to write to a specific set of
//	bytes in the double word.
//================================================================


procedure VirtualMainMemoryInterface

	//--------------------------------------------------------
	//Fields to be set by processor at start:
	//--------------------------------------------------------
	decl
	$
	//processor and core IDS to be set by parent module at start
	uint32_t processorID;
	uint32_t coreID;

	//which kind of access this instance performs -- fixed for the
	//lifetime of the instance (e.g. SparcThread's memReadProcedure is
	//always LOAD), set once by the parent module's init.
	MemAccessType memoryAccessType;

	//total number of requests made by this procedure
	uint64_t requestCount;
	$
	init
	$
		processorID=0;
		coreID=0;
		memoryAccessType = MemAccessType::NO_ACCESS;
		requestCount = 0;
	$

	//--------------------------------------------------------
	//Access latency, modeled on the core side of this interface.
	//--------------------------------------------------------
	//
	//Cycles only (not phases): the number of *extra* cycles this
	//procedure blocks its caller for, beyond the 0-delay procedure-call
	//semantics it would otherwise have. Default 0. Lets a directly
	//connected VirtualMainMemory/Mmu (or, later, a cache) have an access latency
	//approximated here without that latency needing to be modeled by the
	//connected procedure itself. Independent of, and in addition to, the
	//opcode-wise per-instruction delay applied in SparcThread (see
	//OpcodeLatencies.h).
	decl$uint32_t delay;$
	init$delay = 0;$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//This procedure's own public request/response state -- Ref this
	//file's own header comment. SparcThread.sitar sets the request
	//fields directly (request.address, request.asi, request.word0,
	//request.word1, request.byteMask) before calling `run`, and reads
	//the response fields (response.readWord0, response.readWord1,
	//response.mae) afterwards.
	//--------------------------------------------------------
	include
	$
	#include"MemoryInterfaces.h"
	$

	decl
	$
	VirtualMemoryRequest  request;
	VirtualMemoryResponse response;
	$
	init
	$
	request.valid      = false;
	request.accessType = MemAccessType::NO_ACCESS;
	request.address    = 0;
	request.asi        = 0;
	request.word0      = 0;
	request.word1      = 0;
	request.byteMask   = 0;

	response.valid     = false;
	response.readWord0 = 0;
	response.readWord1 = 0;
	response.mae       = false;
	$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Stats collection
	//--------------------------------------------------------
	decl
	$
	long unsigned int numAccesses;  //total number of mem accesses finished
	long double 	  totalLatency; //sum of latencies of all accesses (cycles)

	//start time of the access currently in flight
	long unsigned int startTime;
	$
	init
	$
	numAccesses=0;
	totalLatency=0;
	$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Connection to whatever is servicing this interface (VirtualMainMemory
	//or Mmu, or later a cache) -- pointers directly into that downstream
	//procedure's own local request/response fields, wired up by the
	//parent module at init (Ref this file's header comment).
	//--------------------------------------------------------

	decl
	$
	VirtualMemoryRequest*  downstreamRequest;
	VirtualMemoryResponse* downstreamResponse;
	$
	init
	$
	downstreamRequest  = NULL;
	downstreamResponse = NULL;
	$
	//--------------------------------------------------------


	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
behavior

	//check that this instance has been initialized by the parent module
	//correctly before making any request
	$
	assert(memoryAccessType!=MemAccessType::NO_ACCESS);
	assert(downstreamRequest);
	assert(downstreamResponse);
	$;

	//wait until whatever is servicing this interface is free, then issue
	//the request
	wait until (this_phase==0 and not($downstreamRequest->valid$));

	$
	startTime = current_time.cycle();
	log<<endl<<"[t="<<current_time<<"] Started memory reference of type "<<accessTypeToString(memoryAccessType)
	   <<" for address 0x"<<std::hex<<request.address<<std::dec;

	//Individual field writes onto the *shared* downstream object -- not
	//an aggregate copy of `request` (Ref this file's header comment on
	//`valid`). downstreamRequest->valid is set last and explicitly: it
	//is this procedure's own handshake flag on the downstream side, not
	//a payload field being relayed from `request`.
	downstreamRequest->accessType = memoryAccessType;
	downstreamRequest->address    = request.address;
	downstreamRequest->asi        = request.asi;
	downstreamRequest->word0      = request.word0;
	downstreamRequest->word1      = request.word1;
	downstreamRequest->byteMask   = request.byteMask;
	downstreamRequest->valid      = true;
	$;

	//wait for the response (the access_type check is a cheap consistency
	//check)
	wait until (this_phase==0 and $downstreamResponse->valid and downstreamRequest->accessType==memoryAccessType$);

	$
	//Individual field reads off the *shared* downstream object -- again
	//not an aggregate copy. response.valid is deliberately left
	//untouched here: it belongs to a different handshake (Ref header
	//comment), not to downstreamResponse->valid.
	response.readWord0 = downstreamResponse->readWord0;
	response.readWord1 = downstreamResponse->readWord1;
	response.mae        = downstreamResponse->mae;

	//close the transaction: explicit, individual field writes on the
	//*shared* objects -- frees the responder to service the next request,
	//and frees this (or another) interface to issue one.
	downstreamRequest->valid  = false;
	downstreamResponse->valid = false;
	$;

	//model the configured access latency (default 0 -- see `delay` above)
	if ($delay > 0$) then
		wait(delay, 0);
	end if;

	$
	requestCount++;
	numAccesses++;
	totalLatency += double(current_time.cycle() - startTime);

	log<<endl<<"[t="<<current_time<<"] Finished memory reference of type "<<accessTypeToString(memoryAccessType)
	   <<" for address 0x"<<std::hex<<request.address<<std::dec;
	if(memoryAccessType==MemAccessType::IFETCH) log<<"  Fetched instruction word 0x"<<std::hex<<response.readWord0<<std::dec;
	$;


	nothing;

end behavior
end procedure

