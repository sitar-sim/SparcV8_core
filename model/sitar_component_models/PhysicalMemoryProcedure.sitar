
//================================================================
// procedure PhysicalMemoryProcedure
// Author: Neha Karanjkar
//
// The PM-typed structural twin of MemoryInterface.sitar (Ref that file's
// own header comment for the general chaining pattern and the `valid`-
// ownership rules this file follows identically -- not repeated here).
// The only real difference is the interface shape: this procedure's
// request/response speak PhysicalMemoryRequest/PhysicalMemoryResponse
// (Ref MemoryInterfaces.h) instead of the virtual-side structs --
// a 64-bit physical address (36 bits meaningful, zero-padded above
// that) and 64-bit (one full doubleword) data, with an 8-bit byteMask
// (one bit per byte of that doubleword) and a `lock` bit for an atomic
// access's locked read half. No ASI (already resolved to a physical
// address and a permission decision by the time anything reaches this
// interface) and no distinct atomic access type (Ref
// MemoryInterfaces.h's file comment: an atomic access is a locked READ
// immediately followed by an ordinary WRITE, both through this same
// procedure type, not a third accessType).
//
// Named "...Procedure" rather than "PhysicalMemoryInterface" to avoid
// this procedure sharing a name with the plain C++ PhysicalMemoryInterface
// class (Ref MemoryInterfaces.h) it and MainMemoryPA both implement --
// inside this generated class's own namespace, an unqualified reference
// to the C++ interface would otherwise resolve to this procedure's own
// generated type instead (C++ namespace lookup preferring the nearer
// enclosing scope), breaking every class that actually implements the
// real interface (Ref MainMemoryVA.sitar's header comment for the
// related, but mechanically different, MemCore-collision story).
//
// Called synchronously (via `run`) by MmuUnit.sitar's own behavior,
// exactly the way SparcThread.sitar calls MemoryInterface's 5 instances.
// MmuUnit owns two instances of this procedure, phyMemReadProcedure and
// phyMemWriteProcedure (accessType fixed to READ/WRITE respectively at
// init), both wired by Core.sitar to the same downstream MainMemoryPA --
// only one is ever in flight at a time, same reasoning as
// MemoryInterface.sitar's own multi-requester note.
//================================================================

procedure PhysicalMemoryProcedure

	//--------------------------------------------------------
	//Fields to be set by the parent procedure at start:
	//--------------------------------------------------------
	decl
	$
	//which kind of access this instance performs -- fixed for the
	//lifetime of the instance (e.g. MmuUnit's phyMemReadProcedure is always
	//READ), set once by the parent's init.
	PhysicalAccessType accessType;

	//total number of requests made by this procedure
	uint64_t requestCount;
	$
	init
	$
		accessType = PhysicalAccessType::READ;
		requestCount = 0;
	$

	//--------------------------------------------------------
	//Access latency, modeled on the MMU side of this interface -- the
	//interconnect between the MMU and whatever services it. Independent
	//of, and additive with, MainMemoryPA's own service-time delay, exactly
	//like MemoryInterface.delay/MainMemoryPA.delay are on the virtual side.
	//--------------------------------------------------------
	decl$uint32_t delay;$
	init$delay = 0;$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//This procedure's own public request/response state. The caller
	//(MmuUnit.sitar) is responsible for setting *every* one of
	//request.physicalAddress/data/byteMask/lock explicitly before each
	//`run` -- this instance is reused across calls (Ref Sitar's own
	//"re-activated automatically" semantics: a run procedure's state
	//does not auto-reset between calls, so a field the caller forgot to
	//set would silently carry over from whatever the *previous*,
	//possibly unrelated, transaction left there), not just the fields
	//relevant to the immediate access type.
	//
	//response.valid is deliberately never set or read here -- the
	//caller relies on `run` itself blocking until this procedure fully
	//terminates, exactly the same convention MemoryInterface.sitar's own
	//header comment documents for its local response.valid ("simply
	//never touched... correct today").
	//--------------------------------------------------------
	include
	$
	#include"MemoryInterfaces.h"
	$

	decl
	$
	PhysicalMemoryRequest  request;
	PhysicalMemoryResponse response;
	$
	init
	$
	request.valid           = false;
	request.accessType      = PhysicalAccessType::READ;
	request.lock            = false;
	request.physicalAddress = 0;
	request.data            = 0;
	request.byteMask        = 0;

	response.valid    = false;
	response.readData = 0;
	response.mae      = false;
	$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//Connection to whatever is servicing this interface (MainMemoryPA
	//today) -- pointers directly into that downstream procedure's own
	//local request/response fields, wired up by the parent module at
	//init (Ref MemoryInterface.sitar's own header comment for why).
	//--------------------------------------------------------
	decl
	$
	PhysicalMemoryRequest*  downstreamRequest;
	PhysicalMemoryResponse* downstreamResponse;
	$
	init
	$
	downstreamRequest  = NULL;
	downstreamResponse = NULL;
	$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
	behavior

	$
	assert(downstreamRequest);
	assert(downstreamResponse);
	$;

	wait until (this_phase==0 and not($downstreamRequest->valid$));

	$
	log<<endl<<"[t="<<current_time<<"] Started physical memory reference of type "
	   <<(accessType==PhysicalAccessType::READ ? "READ" : "WRITE")
	   <<" for address 0x"<<std::hex<<request.physicalAddress<<std::dec;

	//Individual field writes onto the *shared* downstream object -- not
	//an aggregate copy of `request` (Ref MemoryInterface.sitar's own
	//header comment on `valid`). downstreamRequest->valid is set last
	//and explicitly.
	downstreamRequest->accessType      = accessType;
	downstreamRequest->lock            = request.lock;
	downstreamRequest->physicalAddress = request.physicalAddress;
	downstreamRequest->data            = request.data;
	downstreamRequest->byteMask        = request.byteMask;
	downstreamRequest->valid           = true;
	$;

	wait until (this_phase==0 and $downstreamResponse->valid and downstreamRequest->accessType==accessType$);

	$
	response.readData = downstreamResponse->readData;
	response.mae      = downstreamResponse->mae;

	downstreamRequest->valid  = false;
	downstreamResponse->valid = false;
	$;

	if ($delay > 0$) then
		wait(delay, 0);
	end if;

	$
	requestCount++;
	log<<endl<<"[t="<<current_time<<"] Finished physical memory reference for address 0x"
	   <<std::hex<<request.physicalAddress<<std::dec;
	$;

	nothing;

	end behavior
end procedure
