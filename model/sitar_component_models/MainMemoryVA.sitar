
//================================================================
// procedure MainMemoryVA
// Author: Neha Karanjkar
//
// A persistent memory model -- wraps the plain C++ MemCore class (`mem`
// below) with a VM-shaped (VirtualMemoryRequest/Response), directly-
// addressed Sitar interface. Used with no MMU downstream of it, by
// configurations with no MMU, e.g. core_only. (Named MainMemoryVA rather
// than MemCore.sitar to avoid this procedure sharing a name with the
// plain C++ class it embeds -- generated Sitar code lives in a class of
// the procedure's own name, so a same-named embedded member does not
// compile: an unqualified reference to it resolves to the enclosing
// class itself, C++'s injected-class-name rule, and if the two also
// happen to share a header-guard macro, as MemCore.h's did, the real
// class's header silently never gets included at all.) A configuration
// with an MMU present uses MainMemoryPA.sitar instead (PM-shaped, sits
// below the MMU, wraps the C++ MainMemory class) -- see that file's own
// header comment and Plan_MMU_integration.md's "Sitar timing model"
// section for how the two relate.
//
// Unlike MemoryInterface (a "function-style" procedure, `run` fresh for
// every access and returning once that one access completes), this
// procedure is entered ONCE via `run` as a branch of a parallel block
// alongside SparcThread -- see Core.sitar:
// "[ run sparcThread; ... || run mainMemory; ]" -- and stays alive for
// the rest of the simulation, servicing requests in an internal loop.
//
// Chaining pattern (Ref MemoryInterface.sitar's own header comment for
// the general form): in a chain of persistent procedures A -> B -> C
// (arrows show request flow), each procedure but the first owns its own
// local VirtualMemoryRequest/VirtualMemoryResponse -- the object its
// immediate upstream neighbor reads/writes -- and each procedure but the
// last holds downstream pointers into the *next* procedure's own local
// request/response. The parent module (Core.sitar) only wires those
// pointers together at init; it does not own or hold a copy of the
// request/response state itself.
//
// This procedure is the last stage in today's core_only chain:
// `request`/`response` below are this procedure's own local storage (the
// object each of SparcThread's 5 memory-interface instances writes
// into/reads via their downstreamRequest/downstreamResponse pointers),
// and there is no downstream pointer of its own, since nothing sits
// below it. This procedure is the responder's half of that one
// handshake: wait for a request, service it, publish the response, wait
// for it to be consumed. Because both sides are procedures running as
// branches of the same parallel block -- not modules connected by nets --
// this handshake can complete within a single phase, i.e. with 0 added
// cycles, exactly like PipelinedProcessor's inter-stage handshake in the
// sitar repo's examples. If more than one requester ever needs to reach
// this same memory (e.g. before ifetch and load/store are split onto
// separate caches), point their downstreamRequest/downstreamResponse
// pointers at this same local request/response -- only one is ever in
// flight at a time under SparcThread's current, strictly sequential FSM.
//
// Owns the actual storage (`mem`, a MemCore) directly -- this is where a
// test's hex-dump memory image gets loaded, via mem.initializeMemory().
// All accesses are double word accesses; addresses must be double word
// aligned; writes/atomics use a byte mask to update a subset of bytes
// within the double word.
//================================================================

procedure MainMemoryVA

	include
	$
	#include"MemCore.h"
	#include"MemoryInterfaces.h"
	#include"BitManipulation.h"
	$

	decl
	$
	MemCore mem;                  //the actual memory storage

	//This procedure's own request/response -- the object whatever is
	//immediately upstream (today, each of SparcThread's 5
	//MemoryInterface instances, via their downstreamRequest/
	//downstreamResponse pointers) reads/writes directly. Owned here,
	//not by the parent module -- Ref this file's header comment.
	VirtualMemoryRequest  request;
	VirtualMemoryResponse response;
	$
	init
	$
	request.valid      = false;
	request.accessType = MemAccessType::NO_ACCESS;
	request.address    = 0;
	request.asi        = 0;
	request.word0      = 0;
	request.word1      = 0;
	request.byteMask   = 0;

	response.valid     = false;
	response.readWord0 = 0;
	response.readWord1 = 0;
	response.mae       = false;
	$

	//--------------------------------------------------------
	//Access latency: how many cycles it takes this memory itself to
	//service a request, i.e. between accepting it and publishing the
	//response. Default 0.
	//
	//This is a distinct knob from MemoryInterface.delay (which models
	//latency on the requester's side of the connection, e.g. an
	//interconnect) -- the two are independent and additive, e.g. a LOAD
	//with MainMemoryVA.delay=3 and MemoryInterface.delay=2 takes 5 extra
	//cycles total, not 3.
	//--------------------------------------------------------
	decl$uint32_t delay;$
	init$delay = 0;$
	//--------------------------------------------------------

	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
	behavior

	do
		wait until (this_phase==0 and $request.valid$);

		$
		log<<endl<<"[t="<<current_time<<"] MainMemoryVA: servicing "<<accessTypeToString(request.accessType)
		   <<" request for address 0x"<<std::hex<<request.address<<std::dec;

		response.readWord0 = 0;
		response.readWord1 = 0;

		if(request.accessType==MemAccessType::IFETCH)
		{
			uint32_t word_aligned_address = request.address & (~0x3);
			response.readWord0 = mem.readWord(word_aligned_address);
		}
		else if(request.accessType == MemAccessType::LOAD)
		{
			uint32_t doubleword_aligned_address = request.address & (~0x7);
			response.readWord0 = mem.readWord(doubleword_aligned_address);
			response.readWord1 = mem.readWord(doubleword_aligned_address + 4);
		}
		else if(request.accessType == MemAccessType::STORE)
		{
			uint32_t doubleword_aligned_address = request.address & (~0x7);
			//read the existing double word
			uint32_t existing0 = mem.readWord(doubleword_aligned_address);
			uint32_t existing1 = mem.readWord(doubleword_aligned_address + 4);

			//modify those bytes for which the byte mask bit is set
			//word0:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(request.byteMask, i, i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(request.word0,(8*(i+1)-1),8*i);
					writeBits(existing0,(8*(i+1)-1),8*i , byte_val);
				};
			};
			//word1:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(request.byteMask, 4+i, 4+i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(request.word1,(8*(i+1)-1),8*i);
					writeBits(existing1,(8*(i+1)-1),8*i , byte_val);
				};
			};

			//write back the modified doubleword
			mem.writeWord(doubleword_aligned_address, existing0);
			mem.writeWord(doubleword_aligned_address + 4, existing1);
		}
		else if(request.accessType == MemAccessType::ATOMIC_LS)
		{
			uint32_t doubleword_aligned_address = request.address & (~0x7);
			//read the existing double word
			response.readWord0 = mem.readWord(doubleword_aligned_address);
			response.readWord1 = mem.readWord(doubleword_aligned_address + 4);

			//make copies for modification
			uint32_t modified0 = response.readWord0;
			uint32_t modified1 = response.readWord1;

			//write those bytes for which the byte mask bit is set
			//word0:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(request.byteMask, i, i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(request.word0,(8*(i+1)-1),8*i);
					writeBits(modified0,(8*(i+1)-1),8*i , byte_val);
				};
			};
			//word1:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(request.byteMask, 4+i, 4+i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(request.word1,(8*(i+1)-1),8*i);
					writeBits(modified1,(8*(i+1)-1),8*i , byte_val);
				};
			};

			//write back the modified doubleword
			mem.writeWord(doubleword_aligned_address, modified0);
			mem.writeWord(doubleword_aligned_address + 4, modified1);
		}
		else if(request.accessType == MemAccessType::FLUSH)
		{
			//This is a flat array with no instruction cache to
			//invalidate, so there is nothing further to do here. Once a
			//real cache stands in for this procedure on the ifetch channel,
			//this is where it would invalidate the relevant line.
		}

		response.mae = false;   //flat memory model: accesses never fault
		$;

		//model this memory's own service latency (default 0 -- see
		//`delay` above) before the response becomes visible
		if ($delay > 0$) then
			wait(delay, 0);
		end if;

		$
		response.valid = true;
		log<<endl<<"[t="<<current_time<<"] MainMemoryVA: response ready for "<<accessTypeToString(request.accessType)
		   <<" request for address 0x"<<std::hex<<request.address<<std::dec;
		$;

		//wait for the requester to consume the response and close the
		//transaction before servicing the next one
		wait until (this_phase==0 and not($response.valid$));

	while(1) end do;

	end behavior
end procedure
