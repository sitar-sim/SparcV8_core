
//================================================================
// Core.sitar
//
// Wrapper module for the SPARC V8 core.
// Currently uses DIRECT_INTERFACE_TO_MEM mode
// (instantaneous memory access via MemCore, no caches).
//
// Later, ports will be added for cache-based memory access.
//================================================================

module Core

	include
	$
	#include "SparcCore.h"
	#include "MemCore.h"
	$

	//Sparc Thread (contains the state machine and memory interface threads)
	procedure sparcThread : SparcThread

	//Local memory for direct-interface mode
	decl $MemCore mainMemory;$

	init
	$
	// Set DIRECT_INTERFACE_TO_MEM mode on all memory threads
	sparcThread.ifetchThread.DIRECT_INTERFACE_TO_MEM   = true;
	sparcThread.memReadThread.DIRECT_INTERFACE_TO_MEM  = true;
	sparcThread.memWriteThread.DIRECT_INTERFACE_TO_MEM = true;
	sparcThread.atomicLoadStoreThread.DIRECT_INTERFACE_TO_MEM = true;
	sparcThread.flushThread.DIRECT_INTERFACE_TO_MEM = true;

	// Point all memory threads to the local memory model
	sparcThread.ifetchThread.mem_core            = &mainMemory;
	sparcThread.memReadThread.mem_core           = &mainMemory;
	sparcThread.memWriteThread.mem_core          = &mainMemory;
	sparcThread.atomicLoadStoreThread.mem_core   = &mainMemory;
	sparcThread.flushThread.mem_core             = &mainMemory;
	$


	behavior
		run sparcThread;

		// When sparcThread terminates, the core has halted.
		// Print summary info.
		$
		log<<endl<<"Core halted.";
		log<<endl<<sparcThread.printInfo();
		$;

		stop simulation;
	end behavior
end module
