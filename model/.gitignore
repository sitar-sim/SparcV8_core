# Build artifacts
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.elf

# cpp_model's build.sh output -- extensionless executable, not caught by
# any pattern above
/cpp_model/sparc_sim_cpp

# sitar_model's build.py output: build/ (translated .sitar->.cpp/.h,
# regenerated from the tracked .sitar sources every build -- already
# caught by the generic `build/` pattern below, listed here just for
# discoverability) and its extensionless executable, not caught by any
# pattern above
/sitar_model/build/
/sitar_model/executable/sparc_sim_sitar
/sitar_model/sitar_scons_config.txt

# SCons
.sconsign.dblite
.sconf_temp/
config.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.env
.venv
env/
venv/

# C/C++
*.d
*.i
*.s
*.su
*.idb
*.pdb
*.ilk
*.map
*.exp
*.lib

# test_simple_ADD.s: a symlink to the hand-written, tracked example
# assembly source in ../../validation/test_simple_ADD/ (not a
# compiler-generated .s intermediate), see cpp_model/README.md and
# sitar_model/README.md
!/cpp_model/test/test_simple_ADD.s
!/sitar_model/executable/test_simple_ADD.s

# Editor/OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Generated docs
site/

# Logs
*.log

# Except test_simple_ADD's two tracked reference traces (see the root
# .gitignore and validation/README.md): the exact path each model writes
# to when built and run from its own folder, so a normal run there keeps
# them up to date directly.
!/cpp_model/test/test_simple_ADD.log
!/sitar_model/executable/test_simple_ADD.log
