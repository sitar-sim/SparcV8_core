# Build artifacts
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.elf

# Every configuration's build output and scratch --
# system_models/<config>/{cpp_model,sitar_model}/{executable,build}/ --
# extensionless executables (derived names, e.g. sparc_sim_cpp_core_only)
# not caught by any pattern above, and build/ (for sitar_model,
# translated .sitar->.cpp/.h, regenerated from the tracked .sitar sources
# every build -- already caught by the generic `build/` pattern below,
# listed here just for discoverability).
/system_models/*/cpp_model/executable/
/system_models/*/cpp_model/build/
/system_models/*/sitar_model/executable/
/system_models/*/sitar_model/build/
sitar_scons_config.txt

# SCons
.sconsign.dblite
.sconf_temp/
config.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.env
.venv
env/
venv/

# C/C++
*.d
*.i
*.s
*.su
*.idb
*.pdb
*.ilk
*.map
*.exp
*.lib

# Editor/OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Generated docs
site/

# Logs
*.log

# Except test_simple_ADD's two tracked reference traces (see the root
# .gitignore and validation/README.md): the exact path each model writes
# to when built and run with --logging from its own folder, so a normal
# run there keeps them up to date directly.
!/system_models/core_only/cpp_model/test_simple_ADD.log
!/system_models/core_only/sitar_model/test_simple_ADD.log
