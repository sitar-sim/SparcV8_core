
//procedure MemoryInterfaceThread


//================================================================
// Procedure to perform blocking memory accesses
//================================================================
//
// NOTE :
//	all accesses are double word accesses.
//	address must be double word aligned
//	For writes: a byte mask is used
//	 to write to a specific set of
//	 bytes in the double word
//
//when DIRECT_INTERFACE_TO_MEM = true
//	causes the interface to read/write directly from MemCore model
//	and memory access is instantaneous (delay not modeled)
//
//when DIRECT_INTERFACE_TO_MEM = false
//	(NOT YET IMPLEMENTED in V2)
//	this procedure will connect to a cache via ports
//	and memory access delays will be modeled.
//================================================================


procedure MemoryInterfaceThread

	//--------------------------------------------------------
	//Fields to be set by processor at start:
	//--------------------------------------------------------
	decl
	$
	//processor and core IDS to be set by parent module at start
	uint32_t processorID;
	uint32_t coreID;

	typedef enum : uint32_t{
		NO_ACCESS  = 0		,
		LOAD  = 1		,
		STORE = 2		,
		IFETCH = 3 		,
		ATOMIC_LS = 4		,
		FLUSH = 5
		} MemAccessTypes;

	MemAccessTypes memoryAccessType;

	inline std::string accessTypeToString(const uint32_t accessType)
	{
		switch(accessType)
		{
			case	NO_ACCESS         : return "NO_ACCESS"		; break;
			case	LOAD              : return "LOAD"		; break;
			case	STORE             : return "STORE"		; break;
			case	IFETCH            : return "IFETCH"		; break;
			case	ATOMIC_LS         : return "ATOMIC_LS"		; break;
			case	FLUSH             : return "FLUSH"		; break;
			default                   : return "INVALID";
		}
	};

	//total number of requests made by this procedure
	uint64_t requestCount;
	$
	init
	$
		processorID=0;
		coreID=0;
		memoryAccessType = NO_ACCESS;
		requestCount = 0;
	$

	//whether this is direct interfacing to Main Memory
	decl$bool DIRECT_INTERFACE_TO_MEM;$
	init$DIRECT_INTERFACE_TO_MEM = false;$

	//--------------------------------------------------------



	//--------------------------------------------------------
	//Input and output variables for each memory access
	//--------------------------------------------------------
	decl
	$
	uint32_t address;     //address to be accessed
	uint32_t addr_space;  //currently ignored. Will be used when virtual memory is implemented

	uint32_t readWord0;
	uint32_t readWord1;
	uint32_t writeWord0;
	uint32_t writeWord1;
	uint32_t instruction;
	uint32_t byte_mask;
	bool 	 MAE;
	$
	init
	$
	address    =0;
	addr_space =0;
	readWord0  =0;
	readWord1  =0;
	writeWord0 =0;
	writeWord1 =0;
	byte_mask  =0;
	MAE        =0;
	$
	//--------------------------------------------------------



	//--------------------------------------------------------
	//Stats collection
	//--------------------------------------------------------
	decl
	$
	long unsigned int numAccesses;  //total number of mem accesses finished
	long double 	  totalLatency; //sum of latencies of all accesses

	//variables to measure latency of each request
	long unsigned int startTime;
	long unsigned int   endTime;
	$
	init
	$
	numAccesses=0;
	totalLatency=0;
	$
	//--------------------------------------------------------




	//--------------------------------------------------------
	//Interface to memory
	//--------------------------------------------------------

	include
	$
	#include<fstream>
	#include<sstream>
	#include"MemCore.h"
	#include"BitManipulation.h"
	$

	decl
	$
	MemCore*   	mem_core;		//for direct interfacing to main memory (to model 0 delay access)
	// TODO: add port-based cache interface for V2 when caches are ported
	$


	init
	$
	mem_core     		= NULL;
	$


	//--------------------------------------------------------
	//Behavior
	//--------------------------------------------------------
behavior

	//check if this thread has been
	//initialized by parent module correctly
	$
	assert(memoryAccessType!=NO_ACCESS);
	if(DIRECT_INTERFACE_TO_MEM)
	{
		assert(mem_core);
	}
	$;


	//start timing the access
	$
	startTime = current_time.cycle();
	std::stringstream ss;
	ss<<"Started memory reference of type "<<accessTypeToString(memoryAccessType)<<" for address 0x"<<std::hex<<address<<std::dec;
	log<<endl<<ss.str();
	$;


	if (DIRECT_INTERFACE_TO_MEM) then
		//perform access directly on memory using MemCore
		$
		if(memoryAccessType==IFETCH)
		{
			uint32_t word_aligned_address = address & (~0x3);
			instruction = mem_core->readWord(word_aligned_address);
		}
		else if(memoryAccessType == LOAD)
		{
			uint32_t doubleword_aligned_address = address & (~0x7);
			readWord0 = mem_core->readWord(doubleword_aligned_address);
			readWord1 = mem_core->readWord(doubleword_aligned_address + 4);
		}
		else if(memoryAccessType == STORE)
		{
			uint32_t doubleword_aligned_address = address & (~0x7);
			//read the existing double word
			uint32_t existing0 = mem_core->readWord(doubleword_aligned_address);
			uint32_t existing1 = mem_core->readWord(doubleword_aligned_address + 4);

			//modify those bytes for which the byte mask bit is set
			//word0:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(byte_mask, i, i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(writeWord0,(8*(i+1)-1),8*i);
					writeBits(existing0,(8*(i+1)-1),8*i , byte_val);
				};
			};
			//word1:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(byte_mask, 4+i, 4+i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(writeWord1,(8*(i+1)-1),8*i);
					writeBits(existing1,(8*(i+1)-1),8*i , byte_val);
				};
			};

			//write back the modified doubleword
			mem_core->writeWord(doubleword_aligned_address, existing0);
			mem_core->writeWord(doubleword_aligned_address + 4, existing1);
		}
		else if(memoryAccessType == ATOMIC_LS)
		{
			uint32_t doubleword_aligned_address = address & (~0x7);
			//read the existing double word
			readWord0 = mem_core->readWord(doubleword_aligned_address);
			readWord1 = mem_core->readWord(doubleword_aligned_address + 4);

			//make copies for modification
			uint32_t modified0 = readWord0;
			uint32_t modified1 = readWord1;

			//write those bytes for which the byte mask bit is set
			//word0:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(byte_mask, i, i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(writeWord0,(8*(i+1)-1),8*i);
					writeBits(modified0,(8*(i+1)-1),8*i , byte_val);
				};
			};
			//word1:
			for(unsigned int i=0;i<=3;i++)
			{
				bool mask_bit = readBits(byte_mask, 4+i, 4+i);
				if(mask_bit)
				{
					uint32_t byte_val = readBits(writeWord1,(8*(i+1)-1),8*i);
					writeBits(modified1,(8*(i+1)-1),8*i , byte_val);
				};
			};

			//write back the modified doubleword
			mem_core->writeWord(doubleword_aligned_address, modified0);
			mem_core->writeWord(doubleword_aligned_address + 4, modified1);
		}
		else if(memoryAccessType == FLUSH)
		{
			//MemCore is a flat array with no instruction cache to invalidate,
			//so there is nothing to do here in direct-interface mode. Once a
			//real cache is connected (port-based mode below), this is where
			//the flush would be conveyed onward to it.
		}

		$;

	else
		// TODO: port-based cache interface to be added when caches are ported.
		// For memoryAccessType==FLUSH specifically, this is where the request
		// should be forwarded to whatever cache is connected on the port (which
		// can then invalidate the relevant line, or simply acknowledge if it
		// has no coherency concern) -- FLUSH should NOT be special-cased away
		// before reaching here once this mode exists.
		$assert(false && "Port-based cache interface not yet implemented in V2");$;

	end if;

	$
	requestCount++;
	numAccesses +=1;

	//stop timer to measure latency
	endTime = current_time.cycle();
	totalLatency += double(endTime-startTime);

	//dump log message
	std::stringstream ss2;
	ss2<<"Finished memory reference of type "<<accessTypeToString(memoryAccessType)<<" for address 0x"<<std::hex<<address<<std::dec;
	if(memoryAccessType==IFETCH) ss2<<"  Fetched instruction word 0x"<<std::hex<<instruction<<std::dec;
	log<<endl<<ss2.str();
	$;


	nothing;

end behavior
end procedure

